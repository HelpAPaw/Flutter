# Supply-chain hardening. See the "npm supply chain" section of CLAUDE.md.
#
# Nearly every npm worm executes from a preinstall/postinstall hook.
#
# The one install script in this tree is @firebase/util@1.15.2's postinstall,
# which regenerates dist/postinstall.js from $FIREBASE_WEBAPP_CONFIG. The
# published tarball already ships that file as a stub, and we do not set that
# env var, so skipping it yields exactly the same result.
ignore-scripts=true
