{
  "name": "help-a-paw-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Help a Paw notifications",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "geofire-common": "^6.0.0",
    "nodemailer": "^9.0.5",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.3.0"
  },
  "private": true
}
