# Supply-chain hardening. See the "npm supply chain" section of CLAUDE.md.
#
# Nearly every npm worm (Shai-Hulud and friends) executes from a preinstall/
# postinstall hook. Nothing in this tree needs one. The shipped dependencies
# with an install script are:
#   - protobufjs, whose postinstall just prints a version advisory to stderr.
#   - @firebase/util (1.15.x, via firebase-admin 14), whose postinstall bakes
#     $FIREBASE_WEBAPP_CONFIG into dist/postinstall.js for the *web* SDK. The
#     tarball already ships that file as a stub returning undefined, and the
#     Admin SDK never sets the variable, so skipping it changes nothing.
#
# This file IS uploaded with the source on `firebase deploy` — verified
# 2026-08-17 by inflating it and watching the packaged payload grow from
# 183.05 KB to 495.1 KB — so it also disables scripts in the Cloud Build
# install. Two consequences:
#   - NEVER put a registry token (_auth/_authToken) in here. It would be
#     shipped to Cloud Build and stored with the function source.
#   - If you add a dependency that needs an install script, re-verify with
#     `rm -rf node_modules && npm ci && npm run build && npm test` before
#     relaxing this.
ignore-scripts=true
